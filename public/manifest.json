{
  "manifest_version": 3,
  "name": "Illini Dash",
  "version": "1.0.0",
  "key": "",
  "description": "Every UIUC deadline from Canvas, Gradescope, PrairieLearn, PrairieTest, smartPhysics and course sites in one list.",
  "minimum_chrome_version": "116",
  "homepage_url": "https://github.com/sushelan/illini-dash",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Illini Dash",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Open Illini Dash"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen",
    "contextMenus",
    "scripting",
    "identity",
    "cookies"
  ],
  "oauth2": {
    "client_id": "56830223805-vb18i137icv8g26rouu86vc9qifghh91.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/calendar.app.created"
    ]
  },
  "host_permissions": [
    "https://canvas.illinois.edu/*",
    "https://www.gradescope.com/*",
    "https://us.prairielearn.com/*",
    "https://us.prairietest.com/*",
    "https://smart.physics.illinois.edu/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
