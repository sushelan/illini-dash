{
  "manifest_version": 3,
  "name": "Illini Due",
  "version": "0.1.0",
  "description": "Every UIUC deadline from Canvas, Gradescope, PrairieLearn, PrairieTest and course sites in one list.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Illini Due",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "options_page": "options.html",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "https://canvas.illinois.edu/*",
    "https://www.gradescope.com/*",
    "https://us.prairielearn.com/*",
    "https://us.prairietest.com/*",
    "https://raw.githubusercontent.com/*"
  ],
  "optional_host_permissions": [
    "https://*.illinois.edu/*"
  ],
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
