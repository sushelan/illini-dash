{"nodes": [{"id": "src_core_health_healthpill", "label": "healthPill (core/health.ts)", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_ui_css", "label": "ui.css shared stylesheet", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_options_page", "label": "options.html: Settings page", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Retitled from 'Illini Dash \u2014 debug'; build ids moved under Developer because 'Service worker alive, build \u2026' was the first line a student read and meant nothing to them."}, {"id": "public_options_options_js", "label": "options.js module script", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_options_back_link", "label": "#back plain link to popup.html?view=full", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A link, not a script: works before the page has talked to the worker and if that fails; goes to the full view rather than history.back() because the popup remembers which tab you were on."}, {"id": "public_options_page_sub", "label": "#page-sub: version, last check, sources answered", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "From the same healthPill the popup header uses, so the two cannot disagree."}, {"id": "public_options_build_info", "label": "#build-info warning slot, hidden unless wrong", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_options_pagenav", "label": "#pagenav built from the sections' data-nav", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One list rather than two that can disagree; thirteen headings in a 1900px column meant scrolling past everything to find Reminders."}, {"id": "public_options_sec_sources", "label": "#sec-sources: per-source rows and Choose again", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each source is read with the session already in the browser; switching one off stops it counting toward the line at the top."}, {"id": "public_options_sec_courses", "label": "#sec-courses: courses and Older courses (#set-aside)", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canvas still lists set-aside courses as active but they belong to an earlier term \u2014 usually a compliance course that never closes."}, {"id": "public_options_sec_sites", "label": "#sec-sites: course websites, registry refresh, Add a course site", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A course website is a URL and a few CSS selectors so a broken one is fixed without updating the extension; switching one on asks Chrome for that one site's permission."}, {"id": "public_options_sec_reminders", "label": "#sec-reminders", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "public_options_sec_appearance", "label": "#sec-appearance: theme presets, no colour picker", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Colour carries meaning \u2014 red overdue, amber open window, green answered \u2014 and a free choice lets two collide so the result looks fine and lies."}, {"id": "public_options_sec_tidy", "label": "#sec-tidy: Hidden and Ticked off rows", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Course websites and paper hand-ins never report a submission, so a local tick is the only way those rows finish; if a source later says missing the row comes back."}, {"id": "public_options_sec_data", "label": "#sec-data: Download .ics, Export JSON, Reset", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The .ics is a one-time copy, not a subscription; Reset deletes every row and correction and cannot be undone."}, {"id": "public_options_sec_help", "label": "#sec-help: Copy diagnostics and Report a page", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Diagnostics carry no titles, links or identifying data, so they are safe to paste into a bug report."}, {"id": "public_options_report_box", "label": "#report-box: Prepare a report (NetID, name, URL)", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Name and NetID are used only to find and remove them from the page; the reason comes first and the whole thing is behind a disclosure. Nothing is sent automatically."}, {"id": "public_options_sec_dev", "label": "#sec-dev: Developer panel", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Nothing here runs on its own; Chrome reloads the page from disk but keeps the running worker, so the two can be different builds."}, {"id": "public_options_gate0", "label": "Gate 0 cookie-authenticated fetch check (#run-gate0)", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetches each source's authenticated home page from the worker with credentials include; nothing is stored."}, {"id": "public_options_selftest", "label": "Offscreen parser round-trip check (#run-selftest)", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Also checks that a structurally empty page comes back as ParseError rather than an empty list."}, {"id": "public_options_fixture_capture", "label": "Fixture capture (#run-capture, #capture-presets)", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetches a page the way the sync loop will, scrubs it per Appendix A and hands it back as a download."}, {"id": "src_ui_options", "label": "src/ui/options.ts (options page script)", "file_type": "code", "source_file": "public/options.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "public_options_page", "target": "public_options_options_js", "