{"nodes": [{"id": "docs_store_privacy_policy", "label": "Illini Dash privacy policy (2026-09-12)", "file_type": "document", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Published at sushelan.github.io/illini-dash/privacy.html from the gh-pages branch by npm run site."}, {"id": "docs_store_privacy_policy_local_only", "label": "Runs entirely in the browser; never sees a password", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads sites using login sessions already in the browser; all data in extension storage, never transmitted to the developer or any third party."}, {"id": "docs_store_privacy_policy_what_it_reads", "label": "What it reads per site (six rows)", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Canvas courses and planner via API; Gradescope course list and assignments tables; PL course instances and assessments; PT reservations and open exams; smartPhysics PHYS 211-214 enrolments; one page per enabled course website. No more often than every 15 minutes."}, {"id": "docs_store_privacy_policy_tab_load_notice", "label": "Notices page loads on permitted sites, not a history", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "So signing in is noticed straight away instead of up to half an hour later; Chrome reveals a tab's address only where permission already exists; the address is checked against the list and discarded."}, {"id": "docs_store_privacy_policy_daily_registry_fetch", "label": "Daily cookieless fetch of one public file on raw.githubusercontent.com", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The only outbound request not to one of the sites; lists supported course websites and carries no information about the user."}, {"id": "docs_store_privacy_policy_no_server_no_analytics", "label": "No server, account, analytics, telemetry or error reporting", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_store_privacy_policy_what_is_stored", "label": "What is stored: deadlines, courses, settings, corrections in chrome.storage.local", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not synced between devices; neither others nor the developer can read it; deadlines more than 60 days past are deleted automatically."}, {"id": "docs_store_privacy_policy_permissions_table", "label": "Permissions and why each is needed", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Does not request all websites, browsing history or tabs."}, {"id": "docs_store_privacy_policy_broken_page_report", "label": "Reporting a broken page uploads nothing", "file_type": "concept", "source_file": "docs/store/privacy-policy.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extension fetches the page, removes what it recognises as identifying and hands the user a file; the scrubber is not a guarantee, so read it before attaching to a public issue."}], "edges": [{"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_local_only", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_what_it_reads", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_tab_load_notice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_daily_registry_fetch", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_no_server_no_analytics", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_what_is_stored", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_permissions_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-policy.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_policy", "target": "docs_store_privacy_policy_broken_page_report", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/stor