{"nodes": [{"id": "docs_store_privacy_practices", "label": "Chrome Web Store privacy practices form answers", "file_type": "document", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Eight blocks, each plain text under 1000 characters, pasted into the developer console."}, {"id": "docs_store_privacy_practices_single_purpose", "label": "Single purpose: one student's own deadlines on one calendar", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Does not modify sites, inject anything, or run content scripts; no account, server or second feature."}, {"id": "docs_store_privacy_practices_storage", "label": "storage justification (form)", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Without it every source would be re-fetched on every popup open, hitting course sites far more often than necessary."}, {"id": "docs_store_privacy_practices_alarms", "label": "alarms justification (form)", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An MV3 worker is torn down when idle; chrome.alarms is the only supported way to wake it for the 30-minute check (15-120 adjustable) and for each reminder."}, {"id": "docs_store_privacy_practices_notifications", "label": "notifications justification (form)", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "24h and 2h reminders plus a daily booking reminder; quiet hours respected; no promotional notification of any kind."}, {"id": "docs_store_privacy_practices_offscreen", "label": "offscreen justification (form)", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The documented DOM_PARSER reason; the document stores nothing and is not used for audio, clipboard or scraping."}, {"id": "docs_store_privacy_practices_contextmenus", "label": "contextMenus justification (form)", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exactly one item, appearing only on supported course sites; the report is assembled locally and handed to the user."}, {"id": "docs_store_privacy_practices_host_permission", "label": "Host permission justification (form)", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Up front rather than optional because the check runs on a background schedule with no user gesture to request from; no content scripts registered."}, {"id": "docs_store_privacy_practices_remote_code_no", "label": "Remote code: No", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The daily fetch returns data \u2014 CSS selectors, a date format, a timezone, a filter pattern \u2014 interpreted by a runner inside the package; no eval, no new Function, no remote script."}, {"id": "docs_store_privacy_practices_website_content_yes", "label": "Data usage: check Website content only", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An earlier version said check nothing because nothing is transmitted; Google's User Data FAQ says local-only handling must still be disclosed, so assignment titles, course names, due dates and links kept in chrome.storage.local count."}, {"id": "docs_store_privacy_practices_web_history_judgment", "label": "Web history stays unchecked \u2014 a judgment call", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps one integer per source (last page-load time on a permitted site) in session storage, cleared on browser close, used only to decide staleness; not a list of visited pages. If a reviewer disagrees, check it rather than argue."}, {"id": "docs_store_privacy_practices_pii_not_collected", "label": "PII and authentication not collected", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The broken-page report asks for a NetID and name only to remove them, held in memory; verified no write path exists. The browser attaches the session; no password or cookie is read."}, {"id": "docs_store_privacy_practices_certifications", "label": "Certify all three (no sale, single purpose, no creditworthiness)", "file_type": "concept", "source_file": "docs/store/privacy-practices.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_store_privacy_practices", "target": "docs_store_privacy_practices_single_purpose", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/privacy-practices.txt", "source_location": null, "weight": 1.0}, {"source": "docs_store_privacy_practices", "target":