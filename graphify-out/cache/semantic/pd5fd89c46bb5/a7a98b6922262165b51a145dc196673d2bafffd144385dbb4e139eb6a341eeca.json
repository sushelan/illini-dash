{"nodes": [{"id": "docs_store_listing", "label": "Chrome Web Store listing draft (\u00a79 G5)", "file_type": "document", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Not submitted: G5 is a gate and needs the developer account."}, {"id": "docs_store_listing_short_description", "label": "Short description (116 of 132 chars)", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_store_listing_plain_text_description_rule", "label": "Description field is plain text: paste description.txt", "file_type": "rationale", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The store field preserves line breaks and nothing else, so Markdown would ship as literal asterisks; a doc written to be read in a repo and a field that renders nothing are different media, and keeping one copy meant shipping the wrong one."}, {"id": "docs_store_listing_category_workflow_planning", "label": "Category: Workflow & Planning", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'Productivity' no longer exists on the form; Education is where things you learn from live, and this is a planner that reads coursework. The store allows one category."}, {"id": "docs_store_listing_permission_storage", "label": "storage permission justification", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Stores deadlines, settings and manual corrections locally; no remote storage exists."}, {"id": "docs_store_listing_permission_alarms", "label": "alarms permission justification", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Schedules the periodic deadline check and the individual reminders."}, {"id": "docs_store_listing_permission_notifications", "label": "notifications permission justification", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Displays the reminders the user enabled."}, {"id": "docs_store_listing_permission_offscreen", "label": "offscreen permission justification", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An MV3 service worker has no DOM parser; pages are parsed in an offscreen document with the browser's inert HTML parser that runs no scripts and loads no resources."}, {"id": "docs_store_listing_permission_contextmenus", "label": "contextMenus permission justification", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One right-click item, 'Report this page to Illini Dash', opens the extension's own settings page with the address filled in; nothing is sent without the user pressing a button."}, {"id": "docs_store_listing_permission_host_permissions", "label": "host_permissions for the five sites", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reads the user's own assignment and exam pages using the session already in the browser; requests only pages the account can already see."}, {"id": "docs_store_listing_permission_optional_host_permissions", "label": "optional_host_permissions for course websites", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Many UIUC course sites are their own domains (cs124.org, cs225.org) so the host cannot be known in advance; one host is requested at runtime when the user turns that course's site on, and Chrome's prompt names it. An adapter may not name a host already granted."}, {"id": "docs_store_listing_permission_commands", "label": "commands permission justification", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One suggested shortcut Alt+Shift+D, the standard _execute_action, opens the popup and does nothing else."}, {"id": "docs_store_listing_single_purpose", "label": "Single purpose: the user's own coursework deadlines in one list", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No <all_urls>, tabs or webRequest: six specific origins and nothing else."}, {"id": "docs_store_listing_remote_code_none", "label": "Remote code: none \u2014 adapters are data, not code", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Course-site support is a JSON file of CSS selectors fetched daily and schema-validated; it cannot introduce behaviour, only which page is read and which elements are selected."}, {"id": "docs_store_listing_data_disclosure", "label": "Data disclosure form: website content read locally, never transmitted", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_store_listing_screenshots", "label": "Generated store screenshots (npm run shots)", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The harness renders the real dist/popup.js and dist/options.js with only chrome.* stubbed against real row shapes from scripts/preview-data.ts, so they are screenshots of the shipping build and regenerate when the UI changes. Taken from the full view because a 400px popup in a 1280 frame is mostly empty."}, {"id": "docs_store_listing_toast_composite", "label": "store-toast.png is a composite, not a screenshot", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A real Chrome notification cannot be captured from inside the extension; wording is copied from notificationContent's actual output and tests/schedule.test.ts quotes the same strings, so the image cannot promise what the build does not do."}, {"id": "docs_store_listing_promo_tile", "label": "Promo tile 440x280 from ui.css tokens", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drawn from ui.css's own tokens and the shipping icon so it cannot drift; the 1400x560 marquee is optional and a banner with nothing in it is worse than none."}, {"id": "docs_store_listing_icon", "label": "Store icon: navy tile, one orange bar, white tick", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "32px was missing and is what a toolbar draws at 2x; two 14-unit bars blurred at 16px so the shipped mark spends the width on one 20-unit bar. Not the Block I: it is a registered trademark and the listing says not affiliated."}, {"id": "docs_store_listing_g5_checklist", "label": "Before-submitting checklist (G5)", "file_type": "concept", "source_file": "docs/store/listing.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "G4 first; developer account; privacy policy live at sushelan.github.io; version 1.0.0 because 0.1.0 beside a review prompt reads as 'do not rely on this'; tests/manifest.test.ts asserts every fetched origin is in host_permissions and every permission has a justification \u2014 smartPhysics and contextMenus were both missing."}], "edges": [{"source": "docs_store_listing", "target": "docs_store_listing_short_description", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_plain_text_description_rule", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_category_workflow_planning", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_storage", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_alarms", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_notifications", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_offscreen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_contextmenus", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_host_permissions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_optional_host_permissions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_permission_commands", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_single_purpose", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_store_listing_remote_code_none", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/store/listing.md", "source_location": null, "weight": 1.0}, {"source": "docs_store_listing", "target": "docs_st