{
  "name": "illini-dash",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "site": "node scripts/site.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "pretest": "node build.mjs",
    "test": "vitest run",
    "scrub": "node scripts/scrub-file.mjs",
    "propose": "node scripts/propose.mjs",
    "package": "node build.mjs && node scripts/package.mjs",
    "preview": "node build.mjs && node scripts/preview.mjs",
    "shots": "node build.mjs && node scripts/preview.mjs && node scripts/shots.mjs",
    "ui:acceptance": "node scripts/ui-acceptance.mjs",
    "test:ui-workflow": "node --test scripts/ui-acceptance.test.mjs",
    "icons": "node scripts/icons.mjs"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^26.4.1",
    "esbuild": "^0.24.0",
    "linkedom": "^0.18.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
